APP_NAME="Olavo TV+"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://plataforma.exemplo.com.br
FRONTEND_URL=https://plataforma.exemplo.com.br
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=olavo_digital
DB_USERNAME=olavo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=plataforma.exemplo.com.br

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=failover
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

UPLOADS_DRIVER=s3
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=
UPLOADS_PUBLIC_URL=

AUDIT_RETENTION_DAYS=730

# storage/app/private/firebase.json
FCM_CREDENTIALS=
